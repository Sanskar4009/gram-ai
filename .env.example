# ==============================================================================
# GramAI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local/docker environments
# DO NOT COMMIT REAL CREDENTIALS OR SENSITIVE DATA TO VERSION CONTROL
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gramai
DB_USERNAME=gramai
DB_PASSWORD=change-me

# Backend Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Authentication (JWT)
# Minimum 512-bit hex/base64 key for HMAC-SHA512
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D635166546A576E5A7234753778214125442A
JWT_EXPIRATION=86400000
SEED_DATA_ENABLED=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=5173

